# Secrets — never commit these
.env
credentials.json

# Runtime state — the deal files hold live bank details, IBANs and Binance IDs,
# so they must never reach the repo. These only exist on the machine running the
# bot; listing all three keeps a stray `git add .` there from committing them.
active_deal.json
active_cash_deal.json
discount_campaign.json

